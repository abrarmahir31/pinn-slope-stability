{
  "meta": {
    "project": "PINN-HM Coupled Slope Stability — Işıkdere Lignite Open-Pit Mine",
    "primary_source": "Ulusay, Ekmekci, Tuncay & Hasancebi (2014), Eng. Geology 181, 261-280; DOI 10.1016/j.enggeo.2014.08.005",
    "phase": "Phase 1 — Data Preparation & Derivation (Steps 1.1-1.5), reference state complete",
    "units": "SI: K_s [m/s], rho [kg/m^3], E [Pa/MPa as noted], sigma_ci [Pa], alpha [1/m]; VG dimensionless except alpha",
    "derivations": {
      "n0": "n0 = 1 - gamma_dry/(gamma_w*Gs), gamma_w=9.81 kN/m^3",
      "E_rm": "Hoek-Diederichs 2006: E_rm = E_i[0.02 + (1-D/2)/(1+exp((60+15D-GSI)/11))], E_i=MR*UCS",
      "HB": "Hoek-Brown 2002: m_b=m_i*exp((GSI-100)/(28-14D)); s=exp((GSI-100)/(9-3D)); a=0.5+(1/6)[exp(-GSI/15)-exp(-20/3)]",
      "VG": "Rosetta3 (Zhang & Schaap 2017) pedotransfer for soils; literature values for marl/coal",
      "KC": "Kozeny-Carman: K_s = K_s0*(n/n0)^3*((1-n0)/(1-n))^2, n=n0+eps_v"
    }
  },
